{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "cmake --preset default",
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "shell",
      "command": "cmake --build --preset default",
      "group": { "kind": "build", "isDefault": true },
      "dependsOn": ["CMake: configure"],
      "problemMatcher": ["$gcc"]
    }
  ]
}
